<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="f450_frame">

    <xacro:property name="frame_mesh" value="file://$(find uav_description)/meshes/frame/f450_frame.STL"/>

    <xacro:property name="model_offset_x"     value="-0.20" />              <!-- Fix the mesh model offset -->
    <xacro:property name="model_offset_y"     value="0.15" />            <!-- Fix the mesh model offset -->
    <xacro:property name="file_scale"         value="0.001 0.001 0.001" />  <!-- The STL file is in millimeters -->

    <link name="base_link">

      <visual>
        <origin xyz="${model_offset_x} ${model_offset_y} 0" rpy="0 0 0"/>

        <geometry>
          <mesh
            filename="${frame_mesh}"
            scale="${file_scale}"/>
        </geometry>

        <material name="frame_black">
          <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
      </visual>

      <collision>
        <origin xyz="${model_offset_x} ${model_offset_y} 0" rpy="0 0 0"/>

        <geometry>
          <cylinder radius="0.25" length="0.05"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="${model_offset_x} ${model_offset_y} 0" rpy="0 0 0"/>

        <mass value="1.2"/>

        <inertia
          ixx="0.03"
          ixy="0.0"
          ixz="0.0"
          iyy="0.03"
          iyz="0.0"
          izz="0.05"/>
      </inertial>

    </link>

  </xacro:macro>

</robot>